# =============================================================================
#  Konfigurasi server API — salin menjadi .env lalu sesuaikan nilainya.
#  Jangan pernah meng-commit berkas .env yang berisi nilai sungguhan.
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Basis data SQLite. Untuk produksi, tempatkan di volume yang di-backup rutin.
DATABASE_PATH=./server/db/pmii.sqlite

# Kunci penanda tangan JWT. Buat nilai acak panjang, mis.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-48-karakter
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# Domain front-end yang diizinkan memanggil API (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:4321,https://pmiiuinbandung.or.id

# Set true bila API sekaligus melayani berkas statis di folder public/.
SERVE_STATIC=false

# --- Integrasi opsional (notifikasi pengaduan & pendaftaran) ------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PK PMII UIN SGD <no-reply@pmiiuinbandung.or.id>"
ADVOKASI_NOTIFY_EMAIL=pmiiuinbandun9@gmail.com

# Gateway WhatsApp (opsional, mis. Fonnte/Wablas)
WA_API_URL=
WA_API_TOKEN=

# --- Keamanan tambahan --------------------------------------------------------
# Biaya bcrypt. 12 = ±250 ms di VPS 2 vCPU. Naikkan bila server lebih kuat.
BCRYPT_COST=12

# Anti-spam formulir publik: turnstile | recaptcha | recaptcha3 | none
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=
CAPTCHA_MIN_SCORE=0.5
# true = loloskan permintaan bila penyedia CAPTCHA tidak dapat dihubungi
CAPTCHA_FAIL_OPEN=true

# --- Penyimpanan berkas -------------------------------------------------------
# local | s3 | cloudinary  (JANGAN memakai local di produksi)
STORAGE_DRIVER=local
# Basis URL publik untuk berkas driver "local"
PUBLIC_BASE_URL=http://localhost:4000
# Basis URL situs, dipakai tautan pada email notifikasi
SITE_URL=https://www.pmiiuinsgd.site

# AWS S3 / Cloudflare R2 / MinIO  → npm install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Cloudinary  → npm install cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Notifikasi ---------------------------------------------------------------
# Penerima pemberitahuan pendaftar MAPABA baru
MAPABA_NOTIFY_EMAIL=
# Nomor WhatsApp pengurus piket untuk pengaduan mendesak (format 62812xxxx)
WA_ADMIN_NUMBER=
