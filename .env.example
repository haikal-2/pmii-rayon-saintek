# =============================================================================
#  Konfigurasi server API — salin menjadi .env lalu sesuaikan nilainya.
#  Jangan pernah meng-commit berkas .env yang berisi nilai sungguhan.
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Basis data SQLite. Untuk produksi, tempatkan di volume yang di-backup rutin.
DATABASE_PATH=./server/db/pmii.sqlite

# Kunci penanda tangan JWT. Buat nilai acak panjang, mis.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-48-karakter
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# Domain front-end yang diizinkan memanggil API (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:4321,https://pmiiuinbandung.or.id

# Set true bila API sekaligus melayani berkas statis di folder public/.
SERVE_STATIC=false

# --- Integrasi opsional (notifikasi pengaduan & pendaftaran) ------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PK PMII UIN SGD <no-reply@pmiiuinbandung.or.id>"
ADVOKASI_NOTIFY_EMAIL=pmiiuinbandun9@gmail.com

# Gateway WhatsApp (opsional, mis. Fonnte/Wablas)
WA_API_URL=
WA_API_TOKEN=
